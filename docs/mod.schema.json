{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aicode.dev/schema/mod.schema.json",
  "title": "AICode mod (mod.json)",
  "description": "See docs/MOD-GUIDE.md",
  "type": "object",
  "required": [
    "id",
    "name",
    "version"
  ],
  "definitions": {
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "notify"
            },
            "message": {
              "type": "string"
            },
            "level": {
              "enum": [
                "info",
                "warning",
                "error"
              ]
            }
          },
          "required": [
            "type",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "insert"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "transform"
            },
            "to": {
              "enum": [
                "upper",
                "lower",
                "title",
                "camel",
                "snake",
                "kebab",
                "trim",
                "sortLines",
                "sortLinesDesc",
                "reverseLines",
                "uniqueLines"
              ]
            }
          },
          "required": [
            "type",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "replace"
            },
            "find": {
              "type": "string"
            },
            "replace": {
              "type": "string"
            },
            "regex": {
              "type": "boolean"
            },
            "caseSensitive": {
              "type": "boolean"
            },
            "scope": {
              "enum": [
                "selection",
                "document"
              ]
            }
          },
          "required": [
            "type",
            "find",
            "replace"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "newFile"
            },
            "text": {
              "type": "string"
            },
            "language": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "openFile"
            },
            "path": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "writeFile"
            },
            "path": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "open": {
              "type": "boolean"
            },
            "ifExists": {
              "enum": [
                "ask",
                "overwrite",
                "append",
                "keep"
              ]
            }
          },
          "required": [
            "type",
            "path",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "openUrl"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "copy"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "shell"
            },
            "command": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            },
            "in": {
              "enum": [
                "output",
                "terminal",
                "background"
              ]
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "command"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "ask"
            },
            "prompt": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "prompt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "command"
            },
            "command": {
              "type": "string"
            },
            "args": {
              "type": "array"
            }
          },
          "required": [
            "type",
            "command"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "confirm"
            },
            "message": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            },
            "button": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Opens a new window with a layout (contributes.windowLayouts or workbench.windowLayouts) or one view.",
          "properties": {
            "type": {
              "const": "window"
            },
            "layout": {
              "type": "string"
            },
            "view": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "alwaysOnTop": {
              "type": "boolean"
            },
            "settings": {
              "type": "object"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Changes a setting in the user's profile: value, toggle or the next of cycle.",
          "properties": {
            "type": {
              "const": "setting"
            },
            "key": {
              "type": "string"
            },
            "owner": {
              "type": "string",
              "description": "A mod id; default AICode's own (core)."
            },
            "path": {
              "type": "string",
              "description": "A key inside an object setting, dotted."
            },
            "value": {},
            "toggle": {
              "type": "boolean"
            },
            "cycle": {
              "type": "array"
            }
          },
          "required": [
            "type",
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "run": {
      "oneOf": [
        {
          "$ref": "#/definitions/action"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/action"
          },
          "minItems": 1
        }
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,95}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "description": "A codicon name, e.g. \"rocket\""
    },
    "api": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "main": {
      "type": "string",
      "description": "Code mods only"
    },
    "activation": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Code mods only"
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "fs:read",
          "fs:write",
          "process",
          "pty",
          "mcp-server",
          "open-external"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,95}$"
      }
    },
    "optionalDependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,95}$"
      }
    },
    "contributes": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "icon": {
                "type": "string",
                "description": "A codicon name, e.g. \"rocket\""
              },
              "keybinding": {
                "type": "string"
              },
              "hidden": {
                "type": "boolean"
              },
              "run": {
                "$ref": "#/definitions/run"
              }
            }
          }
        },
        "keybindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "command"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "args": {}
            }
          }
        },
        "statusBar": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "command"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "icon": {
                "type": "string",
                "description": "A codicon name, e.g. \"rocket\""
              },
              "tooltip": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array"
              },
              "align": {
                "enum": [
                  "left",
                  "right"
                ]
              },
              "priority": {
                "type": "number"
              }
            }
          }
        },
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "icon": {
                "type": "string",
                "description": "A codicon name, e.g. \"rocket\""
              },
              "location": {
                "enum": [
                  "sidebar",
                  "secondary",
                  "panel"
                ]
              },
              "order": {
                "type": "number"
              },
              "keybinding": {
                "type": "string"
              },
              "markdown": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "command"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "icon": {
                      "type": "string",
                      "description": "A codicon name, e.g. \"rocket\""
                    },
                    "command": {
                      "type": "string"
                    },
                    "args": {
                      "type": "array"
                    }
                  }
                }
              }
            }
          }
        },
        "editorContextMenu": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "command"
            ],
            "properties": {
              "command": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "when": {
                "enum": [
                  "selection",
                  "always"
                ]
              }
            }
          }
        },
        "snippets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "language"
            ],
            "properties": {
              "language": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "prefix",
                    "body"
                  ],
                  "properties": {
                    "prefix": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ]
                    },
                    "body": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ]
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "uiTheme": {
                "enum": [
                  "vs",
                  "vs-dark",
                  "hc-black"
                ]
              },
              "path": {
                "type": "string"
              },
              "colors": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "tokenColors": {
                "type": "array"
              }
            }
          }
        },
        "iconThemes": {
          "type": "array",
          "description": "File icon themes: VS Code file-icon-theme JSON files (font glyphs or SVG iconPath). The setting workbench.iconTheme picks one by id.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "What workbench.iconTheme is set to, e.g. \"seti\"."
              },
              "label": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "description": "The theme JSON, relative to the mod folder. Its fonts and iconPaths are relative to it."
              }
            }
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "extensions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "filenames": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "configuration": {}
            }
          }
        },
        "grammars": {
          "type": "array"
        },
        "settings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "default": {},
              "description": {
                "type": "string"
              },
              "enum": {
                "type": "array"
              }
            }
          }
        },
        "configurationDefaults": {
          "type": "object",
          "description": "Defaults for any setting, written like profile.json's settings: { \"core\": { \"editor.cursorColor\": \"#f0f\" }, \"<mod id>\": { … } }. Keys that are not an owner are core settings. The user's own values still win. See docs/CONFIGURATION.md.",
          "additionalProperties": true
        },
        "styles": {
          "type": "array",
          "description": "CSS added while the mod is on: a file of the mod or inline CSS. Parts carry data-part=\"<name>\".",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "css": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "titleBar": {
          "type": "array",
          "description": "Buttons in the title bar.",
          "items": {
            "type": "object",
            "required": [
              "command"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array"
              },
              "align": {
                "enum": [
                  "left",
                  "center",
                  "right"
                ]
              },
              "order": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "windowLayouts": {
          "type": "object",
          "description": "Named window layouts (joined to workbench.windowLayouts). Open one with a { \"type\": \"window\", \"layout\": \"name\" } action.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "alwaysOnTop": {
                "type": "boolean"
              },
              "center": {
                "type": "string",
                "description": "A view in place of the editor."
              },
              "views": {
                "type": "object",
                "additionalProperties": {
                  "enum": [
                    "sidebar",
                    "secondary",
                    "panel",
                    "center",
                    "hidden"
                  ]
                }
              },
              "options": {
                "type": "object",
                "properties": {
                  "activityBar": {
                    "type": "boolean"
                  },
                  "statusBar": {
                    "type": "boolean"
                  },
                  "sidebarSide": {
                    "enum": [
                      "left",
                      "right"
                    ]
                  },
                  "panelAlign": {
                    "enum": [
                      "left",
                      "right",
                      "center",
                      "justify"
                    ]
                  },
                  "quickInput": {
                    "enum": [
                      "top",
                      "center"
                    ]
                  },
                  "density": {
                    "enum": [
                      "default",
                      "compact"
                    ]
                  }
                }
              },
              "parts": {
                "type": "object",
                "properties": {
                  "sidebar": {
                    "type": "boolean"
                  },
                  "secondary": {
                    "type": "boolean"
                  },
                  "panel": {
                    "type": "boolean"
                  }
                }
              },
              "sizes": {
                "type": "object",
                "properties": {
                  "sidebar": {
                    "type": "number"
                  },
                  "secondary": {
                    "type": "number"
                  },
                  "panel": {
                    "type": "number"
                  }
                }
              },
              "hide": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "settings": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "chatAgents": {
          "type": "array",
          "description": "Agents for the AI Chat (aicode.agents). The mod needs a main that exports { chatAgents: { <id>: agent } } — see MODS.md, Agents for the AI Chat.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  }
}
