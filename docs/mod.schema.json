{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aicode.dev/schema/mod.schema.json",
  "title": "AICode mod (mod.json)",
  "description": "See docs/MOD-GUIDE.md",
  "type": "object",
  "required": [
    "id",
    "name",
    "version"
  ],
  "definitions": {
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "notify"
            },
            "message": {
              "type": "string"
            },
            "level": {
              "enum": [
                "info",
                "warning",
                "error"
              ]
            }
          },
          "required": [
            "type",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "insert"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "transform"
            },
            "to": {
              "enum": [
                "upper",
                "lower",
                "title",
                "camel",
                "snake",
                "kebab",
                "trim",
                "sortLines",
                "sortLinesDesc",
                "reverseLines",
                "uniqueLines"
              ]
            }
          },
          "required": [
            "type",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "replace"
            },
            "find": {
              "type": "string"
            },
            "replace": {
              "type": "string"
            },
            "regex": {
              "type": "boolean"
            },
            "caseSensitive": {
              "type": "boolean"
            },
            "scope": {
              "enum": [
                "selection",
                "document"
              ]
            }
          },
          "required": [
            "type",
            "find",
            "replace"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "newFile"
            },
            "text": {
              "type": "string"
            },
            "language": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "openFile"
            },
            "path": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "writeFile"
            },
            "path": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "open": {
              "type": "boolean"
            },
            "ifExists": {
              "enum": [
                "ask",
                "overwrite",
                "append",
                "keep"
              ]
            }
          },
          "required": [
            "type",
            "path",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "openUrl"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "copy"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "shell"
            },
            "command": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            },
            "in": {
              "enum": [
                "output",
                "terminal",
                "background"
              ]
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "command"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "ask"
            },
            "prompt": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "prompt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "command"
            },
            "command": {
              "type": "string"
            },
            "args": {
              "type": "array"
            }
          },
          "required": [
            "type",
            "command"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "confirm"
            },
            "message": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            },
            "button": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "message"
          ],
          "additionalProperties": false
        }
      ]
    },
    "run": {
      "oneOf": [
        {
          "$ref": "#/definitions/action"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/action"
          },
          "minItems": 1
        }
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,95}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "description": "A codicon name, e.g. \"rocket\""
    },
    "api": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "main": {
      "type": "string",
      "description": "Code mods only"
    },
    "activation": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Code mods only"
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "fs:read",
          "fs:write",
          "process",
          "pty",
          "mcp-server",
          "open-external"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,95}$"
      }
    },
    "optionalDependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,95}$"
      }
    },
    "contributes": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "icon": {
                "type": "string",
                "description": "A codicon name, e.g. \"rocket\""
              },
              "keybinding": {
                "type": "string"
              },
              "hidden": {
                "type": "boolean"
              },
              "run": {
                "$ref": "#/definitions/run"
              }
            }
          }
        },
        "keybindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "command"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "args": {}
            }
          }
        },
        "statusBar": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "command"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "icon": {
                "type": "string",
                "description": "A codicon name, e.g. \"rocket\""
              },
              "tooltip": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array"
              },
              "align": {
                "enum": [
                  "left",
                  "right"
                ]
              },
              "priority": {
                "type": "number"
              }
            }
          }
        },
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "icon": {
                "type": "string",
                "description": "A codicon name, e.g. \"rocket\""
              },
              "location": {
                "enum": [
                  "sidebar",
                  "secondary",
                  "panel"
                ]
              },
              "order": {
                "type": "number"
              },
              "keybinding": {
                "type": "string"
              },
              "markdown": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "command"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "icon": {
                      "type": "string",
                      "description": "A codicon name, e.g. \"rocket\""
                    },
                    "command": {
                      "type": "string"
                    },
                    "args": {
                      "type": "array"
                    }
                  }
                }
              }
            }
          }
        },
        "editorContextMenu": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "command"
            ],
            "properties": {
              "command": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "when": {
                "enum": [
                  "selection",
                  "always"
                ]
              }
            }
          }
        },
        "snippets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "language"
            ],
            "properties": {
              "language": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "prefix",
                    "body"
                  ],
                  "properties": {
                    "prefix": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ]
                    },
                    "body": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ]
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "uiTheme": {
                "enum": [
                  "vs",
                  "vs-dark",
                  "hc-black"
                ]
              },
              "path": {
                "type": "string"
              },
              "colors": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "tokenColors": {
                "type": "array"
              }
            }
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "extensions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "filenames": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "configuration": {}
            }
          }
        },
        "grammars": {
          "type": "array"
        },
        "settings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "default": {},
              "description": {
                "type": "string"
              },
              "enum": {
                "type": "array"
              }
            }
          }
        }
      }
    }
  }
}
