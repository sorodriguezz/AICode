{
  "id": "aicode.agents",
  "name": "AI Chat",
  "version": "1.0.0",
  "description": "The AI chat panel: chats with history, the active file and attachments as context, slash commands, code blocks you can apply as a diff or run in the terminal. The agents themselves are mods of their own — Claude, Codex, Gemini, Grok, OpenCode, Cline, Ollama, custom commands — each through its CLI (your subscription) or an API key.",
  "author": "AICode",
  "icon": "comment-discussion",
  "main": "main.js",
  "api": 1,
  "activation": [
    "onView:agents.chat",
    "onCommand:agents.ask",
    "onCommand:agents.attachFile",
    "onCommand:agents.attachSelection",
    "onCommand:agents.showHistory",
    "onCommand:agents.pickAgent",
    "onCommand:agents.configureAgent",
    "onCommand:agents.openInTerminal",
    "onCommand:agents.newChat",
    "onCommand:agents.clearHistory"
  ],
  "permissions": [
    "fs:read",
    "open-external"
  ],
  "optionalDependencies": [
    "aicode.mcp-server",
    "aicode.terminal"
  ],
  "contributes": {
    "views": [
      {
        "id": "agents.chat",
        "title": "Chat",
        "icon": "comment-discussion",
        "location": "secondary",
        "order": 1,
        "keybinding": "mod+alt+i"
      }
    ],
    "commands": [
      {
        "id": "agents.ask",
        "title": "Ask About Selection",
        "category": "Chat",
        "keybinding": "mod+i"
      },
      {
        "id": "agents.newChat",
        "title": "New Chat",
        "category": "Chat"
      },
      {
        "id": "agents.showHistory",
        "title": "Show Chats…",
        "category": "Chat"
      },
      {
        "id": "agents.attachFile",
        "title": "Add File to Chat",
        "category": "Chat"
      },
      {
        "id": "agents.attachSelection",
        "title": "Add Selection to Chat",
        "category": "Chat"
      },
      {
        "id": "agents.pickAgent",
        "title": "Select Agent…",
        "category": "Chat"
      },
      {
        "id": "agents.configureAgent",
        "title": "Configure Agent…",
        "category": "Chat"
      },
      {
        "id": "agents.openInTerminal",
        "title": "Open Agent in Terminal",
        "category": "Chat"
      },
      {
        "id": "agents.clearHistory",
        "title": "Delete All Past Chats…",
        "category": "Chat"
      }
    ]
  }
}
