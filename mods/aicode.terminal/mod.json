{
  "id": "aicode.terminal",
  "name": "Terminal",
  "version": "1.2.1",
  "description": "Integrated terminals with nested rows and columns, draggable panes, layout presets, resizable splits, dropped file references, and an agent CLI launcher. A shell only starts when you open one.",
  "author": "AICode",
  "icon": "terminal",
  "main": "main.js",
  "api": 1,
  "activation": [
    "onView:terminal",
    "onCommand:terminal.new",
    "onCommand:terminal.toggle",
    "onCommand:terminal.newWithProfile",
    "onCommand:terminal.split",
    "onCommand:terminal.focus",
    "onCommand:terminal.runSelection",
    "onCommand:terminal.sendText"
  ],
  "permissions": [
    "pty",
    "fs:read",
    "open-external"
  ],
  "dependencies": ["aicode.bottom-panel"],
  "contributes": {
    "views": [
      {
        "id": "terminal",
        "title": "Terminal",
        "icon": "terminal",
        "location": "panel",
        "order": 1
      }
    ],
    "commands": [
      {
        "id": "terminal.toggle",
        "title": "Toggle Terminal",
        "category": "Terminal",
        "keybinding": "ctrl+`"
      },
      {
        "id": "terminal.new",
        "title": "Create New Terminal",
        "category": "Terminal",
        "keybinding": "ctrl+shift+`"
      },
      {
        "id": "terminal.newWithProfile",
        "title": "Create New Terminal (With Profile)…",
        "category": "Terminal"
      },
      {
        "id": "terminal.newAgent",
        "title": "Open Agent…",
        "category": "Terminal"
      },
      {
        "id": "terminal.splitAgent",
        "title": "Open Agent in Split…",
        "category": "Terminal"
      },
      {
        "id": "terminal.addAgentProfile",
        "title": "Add Agent Profile…",
        "category": "Terminal"
      },
      {
        "id": "terminal.split",
        "title": "Split Terminal",
        "category": "Terminal"
      },
      {
        "id": "terminal.splitDown",
        "title": "Split Terminal Down",
        "category": "Terminal"
      },
      {
        "id": "terminal.splitUp",
        "title": "Split Terminal Up",
        "category": "Terminal"
      },
      {
        "id": "terminal.splitLeft",
        "title": "Split Terminal Left",
        "category": "Terminal"
      },
      {
        "id": "terminal.splitGroupDown",
        "title": "New Terminal Below Entire Group",
        "category": "Terminal"
      },
      {
        "id": "terminal.movePane",
        "title": "Move Pane…",
        "category": "Terminal"
      },
      {
        "id": "terminal.arrange",
        "title": "Arrange Panes…",
        "category": "Terminal"
      },
      {
        "id": "terminal.focus",
        "title": "Focus Terminal",
        "category": "Terminal"
      },
      {
        "id": "terminal.focusNext",
        "title": "Focus Next Terminal",
        "category": "Terminal"
      },
      {
        "id": "terminal.focusPrevious",
        "title": "Focus Previous Terminal",
        "category": "Terminal"
      },
      {
        "id": "terminal.rename",
        "title": "Rename…",
        "category": "Terminal"
      },
      {
        "id": "terminal.kill",
        "title": "Kill the Active Terminal",
        "category": "Terminal"
      },
      {
        "id": "terminal.killAll",
        "title": "Kill All Terminals",
        "category": "Terminal"
      },
      {
        "id": "terminal.clear",
        "title": "Clear",
        "category": "Terminal"
      },
      {
        "id": "terminal.runSelection",
        "title": "Run Selected Text in Active Terminal",
        "category": "Terminal"
      }
    ],
    "settings": {
      "fontSize": {
        "type": "number",
        "default": 12,
        "description": "Font size of terminals"
      },
      "agentProfiles": {
        "type": "array",
        "default": [],
        "description": "Additional interactive agent CLIs shown in Open Agent: [{ \"name\": \"My agent\", \"command\": \"agent-cli\", \"args\": [] }]. Commands use the login-shell PATH and start in the current workspace."
      }
    }
  }
}
