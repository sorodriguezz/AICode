{
  "id": "aicode.terminal-ai",
  "name": "Terminal AI",
  "version": "1.0.0",
  "description": "Launch agent CLIs, configure optional AICode MCP, and paste editor context into a chosen agent terminal. Works independently of AI Chat.",
  "author": "AICode",
  "icon": "robot",
  "main": "main.js",
  "api": 1,
  "activation": [
    "onCommand:terminal.newAgent", "onCommand:terminal.splitAgent", "onCommand:terminal.addAgentProfile",
    "onCommand:terminalAI.sendSelection", "onCommand:terminalAI.sendFile"
  ],
  "permissions": [],
  "dependencies": ["aicode.terminal", "aicode.agent-runtime"],
  "optionalDependencies": ["aicode.mcp-server"],
  "contributes": {
    "commands": [
      { "id": "terminal.newAgent", "title": "Open Agent…", "category": "Terminal AI" },
      { "id": "terminal.splitAgent", "title": "Open Agent in Split…", "category": "Terminal AI" },
      { "id": "terminal.addAgentProfile", "title": "Add Agent Profile…", "category": "Terminal AI" },
      { "id": "terminalAI.sendSelection", "title": "Send Selection to Agent Terminal…", "category": "Terminal AI" },
      { "id": "terminalAI.sendFile", "title": "Send File to Agent Terminal…", "category": "Terminal AI" }
    ],
    "terminalActions": [
      { "icon": "robot", "title": "Open Agent…", "command": "terminal.newAgent" }
    ],
    "menus": {
      "terminal/new": [
        { "command": "terminal.newAgent", "separatorBefore": true },
        { "command": "terminal.splitAgent" },
        { "id": "terminalAI.splitGroup", "command": "terminal.splitAgent", "label": "Open Agent Below Entire Group…", "args": [{ "direction": "below", "scope": "group" }] }
      ],
      "terminal/context": [{ "command": "terminal.splitAgent", "separatorBefore": true }],
      "editor/context": [
        { "command": "terminalAI.sendSelection", "separatorBefore": true },
        { "command": "terminalAI.sendFile" }
      ]
    },
    "settings": {
      "agentProfiles": {
        "type": "array", "default": [],
        "description": "Additional interactive agent CLIs: [{ \"name\": \"My agent\", \"command\": \"agent-cli\", \"args\": [] }]. Commands use the login-shell PATH and start in the current workspace."
      }
    }
  }
}
