        "category": "Git"
      },
      {
        "id": "git.addRemote",
        "title": "Add Remote…",
        "category": "Git"
      },
      {
        "id": "git.removeRemote",
        "title": "Remove Remote",
        "category": "Git"
      },
      {
        "id": "git.stashIncludeUntracked",
        "title": "Stash (Include Untracked)",
        "category": "Git"
      },
      {
