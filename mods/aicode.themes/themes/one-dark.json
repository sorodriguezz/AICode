        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#c678dd"
      }
    },
    {
      "scope": [
        "keyword.json",
        "keyword.yaml"
      ],
      "settings": {
        "foreground": "#d19a66"
      }
    },
    {
      "scope": [
