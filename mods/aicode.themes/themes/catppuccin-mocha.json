        "predefined.sql",
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "scope": [
        "keyword.json",
        "keyword.yaml"
      ],
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "scope": [
