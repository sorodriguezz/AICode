        "string meta.image.inline.markdown"
      ],
      "settings": {
        "foreground": "#93a1a1"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#586e75",
        "fontStyle": "italic"
      }
    },
