        "keyword.operator.logical.python",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export",
        "keyword.other.important.css",
        "keyword.flow",
        "keyword.sql",
        "predefined.sql",
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#ff5792"
      }
    },
    {
      "scope": [
        "keyword.json",
        "keyword.yaml"
      ],
      "settings": {
        "foreground": "#5842ff"
      }
    },
    {
      "scope": [
