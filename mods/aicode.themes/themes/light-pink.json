        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#e17092"
      }
    },
    {
      "scope": [
        "keyword.json",
        "keyword.yaml"
      ],
      "settings": {
        "foreground": "#b08b35"
      }
    },
    {
      "scope": [
