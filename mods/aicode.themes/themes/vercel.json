        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#f75f8f"
      }
    },
    {
      "scope": [
        "keyword.json",
        "keyword.yaml"
      ],
      "settings": {
        "foreground": "#43aaf9"
      }
    },
    {
      "scope": [
