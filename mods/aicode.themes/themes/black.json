        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#e9ca5c"
      }
    },
    {
      "scope": [
        "keyword.json",
        "keyword.yaml"
      ],
      "settings": {
        "foreground": "#e9ca5c"
      }
    },
    {
